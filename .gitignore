# 提交与运行时产生的文件一律不进库
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# 会话落盘产物
.dsh/

# 敏感信息（绝不提交 secrets / API key）
# models.json 内嵌明文 apiKey，永不提交。
.minidsh/models.json
.env
*.key

# 工具链本地缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 非发布内容（本仓库只发布 src/ 库；测试 / 示例 / 文档布局各自独立，不随库分发）
tests/
examples/
*.md
tasks/

# 参考仓库：独立 git 仓库
deepseek-harness-anatomy/
.history/
.vscode/
